<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Puntos_siguiente_nivel__c</fullName>
    <label>Puntos para el siguiente nivel</label>
    <description>Puntos que faltan para subir de nivel (0 si ya es Drama Free).</description>
    <formula>IF(OR(NOT(Miembro_club__c), BLANKVALUE(Drama_Points__c, 0) &gt;= $CustomMetadata.NMD_Club_Config__mdt.General.Umbral_Drama_Free__c), 0, IF(BLANKVALUE(Drama_Points__c, 0) &gt;= $CustomMetadata.NMD_Club_Config__mdt.General.Umbral_Zen__c, $CustomMetadata.NMD_Club_Config__mdt.General.Umbral_Drama_Free__c, $CustomMetadata.NMD_Club_Config__mdt.General.Umbral_Zen__c) - BLANKVALUE(Drama_Points__c, 0))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <precision>8</precision>
    <scale>0</scale>
    <unique>false</unique>
    <required>false</required>
    <type>Number</type>
</CustomField>
