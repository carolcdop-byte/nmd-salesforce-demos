<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Muestras_restantes__c</fullName>
    <label>Muestras disponibles este año</label>
    <description>Límite anual de muestras (NMD_Clinic_Config__mdt) menos las muestras entregadas este año.</description>
    <formula>MAX(0, $CustomMetadata.NMD_Clinic_Config__mdt.General.Limite_anual_muestras__c - BLANKVALUE(Muestras_ano__c, 0))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <precision>4</precision>
    <scale>0</scale>
    <unique>false</unique>
    <required>false</required>
    <type>Number</type>
</CustomField>
