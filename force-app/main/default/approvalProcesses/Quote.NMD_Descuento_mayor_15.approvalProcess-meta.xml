<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Opportunity</field>
        <field>Owner</field>
        <field>Cajas_totales__c</field>
        <field>Descuento_volumen__c</field>
        <field>Discount</field>
        <field>Subtotal</field>
        <field>TotalPrice</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>La jefa de ventas (Manager del comercial) aprueba o rechaza el descuento.</description>
        <label>Jefa de ventas</label>
        <name>Jefa_de_ventas</name>
    </approvalStep>
    <description>NMD Distribución: un presupuesto con descuento total superior al 15 % necesita la aprobación de la jefa de ventas (Manager del propietario).</description>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Quote.Discount</field>
            <operation>greaterThan</operation>
            <value>15</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>NMD_Estado_Aprobado</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>NMD_Marcar_descuento_aprobado</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>NMD_Estado_Rechazado</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>NMD_Estado_En_revision</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>NMD Descuento mayor 15 %</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
