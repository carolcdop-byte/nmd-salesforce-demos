<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>NMD Clinic (call plan): cada noche recalcula visitas, muestras y cobertura de todos los HCP con segmento, porque la cobertura depende del mes y del trimestre en curso.</description>
    <environments>Default</environments>
    <interviewLabel>NMD Clinic Cobertura Diaria {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NMD Clinic Cobertura Diaria</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Recalcular</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Segmento__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-11-18</startDate>
            <startTime>02:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Recalcular</name>
        <label>Recalcular HCP</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>NMD_Clinic_Recalcular_HCP</flowName>
        <inputAssignments>
            <name>hcpId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
