    </assignments>
    <assignments>
        <name>Tramo_10</name>
        <label>Tramo 10 %</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varTramo</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>10</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Aplicar_Lineas</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Tramo_15</name>
        <label>Tramo 15 %</label>
        <locationX>0</locationX>
