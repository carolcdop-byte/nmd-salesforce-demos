    <assignments>
        <name>Tramo_5</name>
        <label>Tramo 5 %</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varTramo</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>5</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Aplicar_Lineas</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Que_Tramo</name>
        <label>¿Qué tramo?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Tramo_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Menos de 50</defaultConnectorLabel>
        <rules>
            <name>Mas_300</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCajas</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>300</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Tramo_15</targetReference>
            </connector>
            <label>300 o más</label>
        </rules>
        <rules>
            <name>Mas_150</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCajas</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>150</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Tramo_10</targetReference>
            </connector>
            <label>150-299</label>
        </rules>
        <rules>
            <name>Mas_50</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCajas</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>50</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Tramo_5</targetReference>
            </connector>
            <label>50-149</label>
        </rules>
    </decisions>
    <description>NMD Distribución. Suma las cajas de todas las líneas del presupuesto (excepto la que se está borrando), elige el tramo de descuento por volumen (menos de 50: 0 %, 50-149: 5 %, 150-299: 10 %, 300 o más: 15 %) y pone en cada línea Descuento = tramo + Descuento adicional (máximo 100 %). Guarda en el presupuesto Cajas totales y Descuento por volumen.</description>
    <environments>Default</environments>
    <formulas>
        <name>fDescuentoLinea</name>
        <dataType>Number</dataType>
        <expression>MIN(100, {!varTramo} + BLANKVALUE({!Aplicar_Lineas.Descuento_adicional__c}, 0))</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>NMD Recalcular Presupuesto {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NMD Recalcular Presupuesto</label>
    <loops>
        <name>Aplicar_Lineas</name>
        <label>Aplicar descuento</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Lineas</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Descuento_Linea</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Guardar_Lineas</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Recorrer_Lineas</name>
        <label>Recorrer líneas</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Lineas</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Sumar_Cajas</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Que_Tramo</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Lineas</name>
        <label>Líneas del presupuesto</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Recorrer_Lineas</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>quoteId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>lineaExcluida</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>QuoteLineItem</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Quantity</queriedFields>
        <queriedFields>Discount</queriedFields>
        <queriedFields>Descuento_adicional__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
