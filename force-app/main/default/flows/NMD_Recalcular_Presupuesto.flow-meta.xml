        <label>Guardar líneas</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Guardar_Presupuesto</targetReference>
        </connector>
        <inputReference>varLineasActualizar</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Guardar_Presupuesto</name>
        <label>Guardar presupuesto</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>quoteId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Cajas_totales__c</field>
            <value>
                <elementReference>varCajas</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Descuento_volumen__c</field>
            <value>
                <elementReference>varTramo</elementReference>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
