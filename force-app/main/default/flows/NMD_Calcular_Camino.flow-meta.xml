            </conditions>
            <connector>
                <targetReference>Aplicar_Contactar_Hoy</targetReference>
            </connector>
            <label>Contactar hoy</label>
        </rules>
        <rules>
            <name>Es_Respuesta_Escrita</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Camino__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Respuesta escrita</stringValue>
                </rightValue>
            </conditions>
            <connector>
