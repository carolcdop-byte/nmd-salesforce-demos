<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Contar_Mes</name>
        <label>Contar visitas del mes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varVisitasMes</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Visitas_Mes</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Visitas_Trimestre</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Contar_Trimestre</name>
        <label>Contar visitas del trimestre</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varVisitasTrimestre</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Visitas_Trimestre</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Muestras_Ano</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Sumar</name>
        <label>Sumar kits</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varMuestras</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Recorrer_Muestras.Cantidad__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Recorrer_Muestras</targetReference>
        </connector>
    </assignments>
    <description>NMD Clinic (call plan). Recalcula en el HCP: visitas realizadas este mes y este trimestre, kits entregados este año, objetivo según segmento y cobertura (Cubierto / Sin cubrir). Objetivos en NMD_Clinic_Config__mdt.General. Puede excluir una visita o una muestra que se está borrando.</description>
    <environments>Default</environments>
    <formulas>
        <name>fCobertura</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(TEXT({!Get_HCP.Segmento__c})), '', IF(CASE(TEXT({!Get_HCP.Segmento__c}), 'A', IF({!varVisitasMes} &gt;= {!Get_Config.Objetivo_A_mes__c}, 1, 0), 'B', IF({!varVisitasMes} &gt;= {!Get_Config.Objetivo_B_mes__c}, 1, 0), 'C', IF({!varVisitasTrimestre} &gt;= {!Get_Config.Objetivo_C_trimestre__c}, 1, 0), 0) = 1, 'Cubierto', 'Sin cubrir'))</expression>
    </formulas>
    <formulas>
        <name>fInicioAno</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!$Flow.CurrentDate}), 1, 1)</expression>
    </formulas>
    <formulas>
        <name>fInicioMes</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!$Flow.CurrentDate}), MONTH({!$Flow.CurrentDate}), 1)</expression>
    </formulas>
    <formulas>
        <name>fInicioTrimestre</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!$Flow.CurrentDate}), FLOOR((MONTH({!$Flow.CurrentDate}) - 1) / 3) * 3 + 1, 1)</expression>
    </formulas>
    <formulas>
        <name>fObjetivo</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!Get_HCP.Segmento__c}), 'A', TEXT({!Get_Config.Objetivo_A_mes__c}) &amp; ' al mes', 'B', TEXT({!Get_Config.Objetivo_B_mes__c}) &amp; ' al mes', 'C', TEXT({!Get_Config.Objetivo_C_trimestre__c}) &amp; ' al trimestre', '')</expression>
    </formulas>
    <interviewLabel>NMD Clinic Recalcular HCP {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NMD Clinic Recalcular HCP</label>
    <loops>
        <name>Recorrer_Muestras</name>
        <label>Recorrer muestras del año</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Muestras_Ano</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Sumar</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Guardar_HCP</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Config</name>
        <label>Configuración NMD Clinic</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_HCP</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>General</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>NMD_Clinic_Config__mdt</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Limite_anual_muestras__c</queriedFields>
        <queriedFields>Objetivo_A_mes__c</queriedFields>
        <queriedFields>Objetivo_B_mes__c</queriedFields>
        <queriedFields>Objetivo_C_trimestre__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_HCP</name>
        <label>HCP</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Visitas_Mes</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>hcpId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Segmento__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Muestras_Ano</name>
        <label>Muestras de este año</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Recorrer_Muestras</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>HCP__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>hcpId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Fecha_entrega__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>fInicioAno</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>muestraExcluida</elementReference>
            </value>
        </filters>
        <filters>
            <field>Visita__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>visitaExcluida</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Muestra_entregada__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Cantidad__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
