            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_Cola.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Pedido__c</field>
