    <decisions>
        <name>Email_Coincide</name>
        <label>¿Email coincide?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Verificado_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No coincide</defaultConnectorLabel>
        <rules>
            <name>Coincide</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contacto_Verificado</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pedido_Entregado</targetReference>
            </connector>
            <label>Coincide</label>
        </rules>
    </decisions>
    <decisions>
        <name>Pedido_Encontrado</name>
        <label>¿Pedido encontrado?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Verificado_Pedido</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No encontrado</defaultConnectorLabel>
        <rules>
            <name>Encontrado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Pedido</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contacto_Verificado</targetReference>
            </connector>
            <label>Encontrado</label>
        </rules>
    </decisions>
    <decisions>
        <name>Pedido_Entregado</name>
        <label>¿Pedido entregado?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asignar_No_Entregado</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No entregado</defaultConnectorLabel>
        <rules>
            <name>Entregado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Pedido.Estado_envio__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Entregado</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Cola</targetReference>
            </connector>
            <label>Entregado</label>
        </rules>
    </decisions>
    <decisions>
        <name>Validar_Entradas</name>
        <label>¿Entradas completas?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Verificado_Entradas</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Incompletas</defaultConnectorLabel>
        <rules>
            <name>Entradas_Completas</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numeroPedido</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>email</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Pedido</targetReference>
            </connector>
            <label>Completas</label>
        </rules>
    </decisions>
    <description>Acción del Agente Zen. Verifica el email contra el contacto de facturación del pedido y, solo si el pedido está Entregado, crea un caso de tipo Devolución vinculado al pedido y al contacto, asignado a la cola Agentes NMD. Devuelve el número de caso.</description>
    <environments>Default</environments>
    <formulas>
        <name>fAsunto</name>
        <dataType>String</dataType>
        <expression>&apos;Devolución solicitada - pedido &apos; &amp; {!Get_Pedido.OrderNumber}</expression>
    </formulas>
    <formulas>
        <name>fDescripcion</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!motivo}), &apos;Motivo no indicado.&apos;, {!motivo})</expression>
    </formulas>
    <formulas>
        <name>fMensajeNoEntregado</name>
        <dataType>String</dataType>
        <expression>&apos;Solo se pueden devolver pedidos entregados. El pedido &apos; &amp; {!Get_Pedido.OrderNumber} &amp; &apos; está en estado &apos; &amp; IF(ISBLANK(TEXT({!Get_Pedido.Estado_envio__c})), &apos;sin estado de envío&apos;, TEXT({!Get_Pedido.Estado_envio__c})) &amp; &apos;.&apos;</expression>
    </formulas>
    <formulas>
        <name>fMensajeOk</name>
        <dataType>String</dataType>
        <expression>&apos;Hemos registrado tu solicitud de devolución del pedido &apos; &amp; {!Get_Pedido.OrderNumber} &amp; &apos; con el caso &apos; &amp; {!Get_Caso.CaseNumber} &amp; &apos;. Te contactaremos con las instrucciones de recogida.&apos;</expression>
    </formulas>
    <interviewLabel>NMD Crear Devolucion {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NMD Crear Devolucion</label>
