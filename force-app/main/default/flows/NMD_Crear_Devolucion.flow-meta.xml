                <elementReference>fAsunto</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <stringValue>Devolución</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
