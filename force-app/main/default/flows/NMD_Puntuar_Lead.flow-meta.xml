<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Caliente</name>
        <label>Caliente</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Puntuacion__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Caliente</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Frio</name>
        <label>Frío</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Puntuacion__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Frío</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Templado</name>
        <label>Templado</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Puntuacion__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Templado</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Puntuacion</name>
        <label>¿Qué puntuación?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Frio</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Frío</defaultConnectorLabel>
        <rules>
            <name>Es_Caliente</name>
            <conditionLogic>1 OR ((2 OR 3) AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Volumen_estimado__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>100</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Tipo_de_negocio__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Festival</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Tipo_de_negocio__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Distribuidor</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Volumen_estimado__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>50</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Caliente</targetReference>
            </connector>
            <label>Caliente</label>
        </rules>
        <rules>
            <name>Es_Templado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Volumen_estimado__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>30</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Templado</targetReference>
            </connector>
            <label>Templado</label>
        </rules>
    </decisions>
    <description>NMD Distribución. Puntuación automática del lead antes de guardar: Caliente (100 o más cajas/mes, o festival o distribuidor con 50 o más), Templado (30-99 cajas/mes), Frío (menos de 30 o sin volumen). Los leads del club Drama Points (consumidores del portal NMD Beverage) no se puntúan.</description>
    <environments>Default</environments>
    <interviewLabel>NMD Puntuar Lead {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NMD Puntuar Lead</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Puntuacion</targetReference>
        </connector>
        <filterFormula>AND(TEXT({!$Record.LeadSource}) &lt;&gt; 'Club Drama Points', OR(ISNEW(), ISCHANGED({!$Record.Volumen_estimado__c}), ISCHANGED({!$Record.Tipo_de_negocio__c}), ISBLANK(TEXT({!$Record.Puntuacion__c}))))</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
