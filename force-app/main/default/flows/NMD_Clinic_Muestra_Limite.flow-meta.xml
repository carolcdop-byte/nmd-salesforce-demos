<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Copiar_Datos_Visita</name>
        <label>Copiar HCP y fecha de la visita</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.HCP__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Visita.HCP__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Fecha_entrega__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Visita.Fecha__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Config</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Sumar</name>
        <label>Sumar kits</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varEntregadas</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Recorrer_Muestras.Cantidad__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Recorrer_Muestras</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Error_Limite</name>
        <label>Límite anual superado</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>{!fMensajeLimite}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Aplica_Limite</name>
        <label>¿Visita realizada y HCP con consentimiento?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No (lo bloquean las reglas de validación)</defaultConnectorLabel>
        <rules>
            <name>Aplica</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Visita.Estado__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Realizada</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_HCP.Consentimiento_RGPD__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Muestras_Ano</targetReference>
            </connector>
            <label>Sí</label>
        </rules>
    </decisions>
    <decisions>
        <name>Supera_Limite</name>
        <label>¿Supera el límite anual?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Supera</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fTotal</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Get_Config.Limite_anual_muestras__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Limite</targetReference>
            </connector>
            <label>Sí</label>
        </rules>
    </decisions>
    <description>NMD Clinic (sample management). Antes de guardar una muestra: copia el HCP y la fecha de la visita y bloquea si, con esta entrega, el HCP supera el límite anual de kits (NMD_Clinic_Config__mdt.General.Limite_anual_muestras__c). Los bloqueos de consentimiento y de visita realizada son reglas de validación.</description>
    <environments>Default</environments>
    <formulas>
        <name>fInicioAno</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!$Flow.CurrentDate}), 1, 1)</expression>
    </formulas>
    <formulas>
        <name>fMensajeLimite</name>
        <dataType>String</dataType>
        <expression>'Límite anual de muestras superado: ' &amp; {!Get_HCP.Name} &amp; ' lleva ' &amp; TEXT({!varEntregadas}) &amp; ' de ' &amp; TEXT({!Get_Config.Limite_anual_muestras__c}) &amp; ' kits este año y esta entrega de ' &amp; TEXT({!$Record.Cantidad__c}) &amp; ' lo supera. Puedes entregar como máximo ' &amp; TEXT(MAX(0, {!Get_Config.Limite_anual_muestras__c} - {!varEntregadas})) &amp; '.'</expression>
    </formulas>
    <formulas>
        <name>fTotal</name>
        <dataType>Number</dataType>
        <expression>{!varEntregadas} + BLANKVALUE({!$Record.Cantidad__c}, 0)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>NMD Clinic Muestra Límite {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NMD Clinic Muestra Límite</label>
    <loops>
        <name>Recorrer_Muestras</name>
        <label>Recorrer muestras del año</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Muestras_Ano</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Sumar</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Supera_Limite</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Config</name>
        <label>Configuración NMD Clinic</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_HCP</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>General</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>NMD_Clinic_Config__mdt</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Limite_anual_muestras__c</queriedFields>
        <queriedFields>Objetivo_A_mes__c</queriedFields>
        <queriedFields>Objetivo_B_mes__c</queriedFields>
        <queriedFields>Objetivo_C_trimestre__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_HCP</name>
        <label>HCP</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Aplica_Limite</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Visita.HCP__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Consentimiento_RGPD__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Muestras_Ano</name>
        <label>Muestras del HCP este año</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Recorrer_Muestras</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>HCP__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Visita.HCP__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Fecha_entrega__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>fInicioAno</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Muestra_entregada__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Cantidad__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Visita</name>
        <label>Visita</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Copiar_Datos_Visita</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Visita__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Visita__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>HCP__c</queriedFields>
        <queriedFields>Fecha__c</queriedFields>
        <queriedFields>Estado__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Visita</targetReference>
        </connector>
        <object>Muestra_entregada__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varEntregadas</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0</numberValue>
        </value>
    </variables>
</Flow>
