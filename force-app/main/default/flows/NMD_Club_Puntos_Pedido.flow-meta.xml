<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Sumar</name>
        <label>Sumar puntos</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varTotal</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Recorrer_Pedidos.Drama_Points__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Recorrer_Pedidos</targetReference>
        </connector>
    </assignments>
    <description>Club Drama Points (NMD Beverage). Cuando un pedido de un socio pasa a Entregado y aún no ha sumado puntos: calcula puntos por pedido + puntos por euro (NMD_Club_Config__mdt), los guarda en el pedido, lo marca como otorgado y recalcula el total del socio sumando sus pedidos (seguro aunque se entreguen varios a la vez). El nivel es una fórmula.</description>
    <environments>Default</environments>
    <formulas>
        <name>fPuntos</name>
        <dataType>Number</dataType>
        <expression>{!Get_Config.Puntos_por_pedido__c} + FLOOR(BLANKVALUE({!$Record.TotalAmount}, 0) * {!Get_Config.Puntos_por_euro__c})</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>NMD Club Puntos Pedido {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NMD Club Puntos Pedido</label>
    <loops>
        <name>Recorrer_Pedidos</name>
        <label>Recorrer pedidos con puntos</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Pedidos_Socio</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Sumar</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Guardar_Socio</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Config</name>
        <label>Configuración del club</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Guardar_Pedido</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>General</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>NMD_Club_Config__mdt</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Puntos_por_pedido__c</queriedFields>
        <queriedFields>Puntos_por_euro__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Pedidos_Socio</name>
        <label>Pedidos del socio con puntos</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Recorrer_Pedidos</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>BillToContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.BillToContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Puntos_otorgados__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Order</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Drama_Points__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Guardar_Pedido</name>
        <label>Guardar puntos en el pedido</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Pedidos_Socio</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Drama_Points__c</field>
            <value>
                <elementReference>fPuntos</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Puntos_otorgados__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Order</object>
    </recordUpdates>
    <recordUpdates>
        <name>Guardar_Socio</name>
        <label>Guardar total en el socio</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.BillToContactId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Drama_Points__c</field>
            <value>
                <elementReference>varTotal</elementReference>
            </value>
        </inputAssignments>
        <object>Contact</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Config</targetReference>
        </connector>
        <filterFormula>AND(TEXT({!$Record.Estado_envio__c}) = 'Entregado', NOT({!$Record.Puntos_otorgados__c}), {!$Record.BillToContact.Miembro_club__c})</filterFormula>
        <object>Order</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varTotal</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0</numberValue>
        </value>
    </variables>
</Flow>
