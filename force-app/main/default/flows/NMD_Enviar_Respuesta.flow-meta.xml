    <decisions>
        <name>Decision_Agente</name>
        <label>¿Enviar?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Pantalla_Cancelado</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cancelar</defaultConnectorLabel>
        <rules>
            <name>Enviar</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Accion</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Enviar</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Interruptor</targetReference>
            </connector>
            <label>Enviar</label>
        </rules>
    </decisions>
    <decisions>
        <name>Hay_Email</name>
        <label>¿El contacto tiene email?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Pantalla_Sin_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Con_Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Caso.Contact.Email</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Config</targetReference>
            </connector>
            <label>Sí</label>
        </rules>
    </decisions>
    <decisions>
        <name>Interruptor</name>
        <label>¿Envío de emails activo?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Registrar_Email_Simulado</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Apagado: simular</defaultConnectorLabel>
        <rules>
            <name>Activo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Config.Envio_emails_activo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Enviar_Email</targetReference>
            </connector>
            <label>Activo</label>
        </rules>
    </decisions>
    <decisions>
        <name>Nivel_Permite</name>
        <label>¿Nivel 1-2?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Pantalla_No_Aplica</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Nivel_1_2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Caso.Nivel_drama__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Caso.Nivel_drama__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>2</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Hay_Email</targetReference>
            </connector>
            <label>Sí</label>
        </rules>
    </decisions>
    <description>Botón Enviar respuesta del Caso (app NMD Care), para casos de nivel 1-2. El agente revisa y edita el borrador. Interruptor NMD_Config__mdt.General.Envio_emails_activo__c: si está apagado no envía nada y registra una tarea completada Email simulado con el texto; si está encendido envía el email al contacto y lo registra en el caso.</description>
    <environments>Default</environments>
    <formulas>
        <name>fAsuntoDefecto</name>
        <dataType>String</dataType>
        <expression>'Re: ' &amp; {!Get_Caso.Subject} &amp; ' [Caso ' &amp; {!Get_Caso.CaseNumber} &amp; ']'</expression>
    </formulas>
    <formulas>
        <name>fAsuntoSimulado</name>
        <dataType>String</dataType>
        <expression>LEFT('Email simulado: ' &amp; {!Asunto}, 255)</expression>
    </formulas>
    <formulas>
        <name>fDescripcionSimulado</name>
        <dataType>String</dataType>
        <expression>'EMAIL SIMULADO (envío de emails desactivado en la configuración NMD). No se ha enviado nada.' &amp; BR() &amp; 'Para: ' &amp; {!Get_Caso.Contact.Email} &amp; BR() &amp; 'Asunto: ' &amp; {!Asunto} &amp; BR() &amp; BR() &amp; {!Cuerpo}</expression>
    </formulas>
    <formulas>
        <name>fMensajeResultado</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Config.Envio_emails_activo__c}, 'Email enviado a ' &amp; {!Get_Caso.Contact.Email} &amp; ' y registrado en el caso.', 'Email simulado registrado en el caso como actividad. El envío de emails está desactivado en la configuración NMD: no se ha enviado nada.')</expression>
    </formulas>
