    <decisions>
        <name>Cuadra_Al_Centimo</name>
        <label>¿El precio unitario cuadra al céntimo?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Linea_Con_Ajuste</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No: dividir</defaultConnectorLabel>
        <rules>
            <name>Cuadra</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fCuadra</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Linea_Exacta</targetReference>
            </connector>
            <label>Sí</label>
        </rules>
    </decisions>
    <decisions>
        <name>Ya_Tiene_Pedido</name>
        <label>¿Ya tiene pedido?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Ya existe</defaultConnectorLabel>
        <rules>
            <name>Sin_Pedido</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Pedido_Existente</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Presupuesto</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <description>NMD Distribución. Cuando una oportunidad pasa a Cerrada ganada y tiene un presupuesto sincronizado, crea el pedido (cuenta, contacto de facturación del presupuesto, Price Book, borrador, Estado de envío Pendiente, entrega prevista en 5 días hábiles) con una línea por cada línea del presupuesto al precio con descuento. Si el precio unitario con descuento no es exacto a céntimos, divide la línea en (cantidad - 1) al precio redondeado hacia abajo y 1 unidad de ajuste, para que el total del pedido cuadre al céntimo con el presupuesto. No crea un segundo pedido si la oportunidad ya tiene uno.</description>
    <environments>Default</environments>
    <formulas>
        <name>fCantidadMenosUna</name>
        <dataType>Number</dataType>
        <expression>{!Recorrer_Lineas.Quantity} - 1</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fCuadra</name>
        <dataType>Boolean</dataType>
        <expression>FLOOR({!Recorrer_Lineas.TotalPrice} * 100 / {!Recorrer_Lineas.Quantity}) * {!Recorrer_Lineas.Quantity} = {!Recorrer_Lineas.TotalPrice} * 100</expression>
    </formulas>
    <formulas>
        <name>fDescripcion</name>
        <dataType>String</dataType>
        <expression>'Pedido creado automáticamente al ganar la oportunidad ' &amp; {!$Record.Name} &amp; '.'</expression>
    </formulas>
    <formulas>
        <name>fEntregaPrevista</name>
        <dataType>Date</dataType>
        <expression>TODAY() + CASE(WEEKDAY(TODAY()), 1, 5, 7, 6, 7)</expression>
    </formulas>
    <formulas>
        <name>fPrecioAjuste</name>
        <dataType>Currency</dataType>
        <expression>{!Recorrer_Lineas.TotalPrice} - FLOOR({!Recorrer_Lineas.TotalPrice} * 100 / {!Recorrer_Lineas.Quantity}) / 100 * ({!Recorrer_Lineas.Quantity} - 1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fPrecioUnitario</name>
        <dataType>Currency</dataType>
        <expression>FLOOR({!Recorrer_Lineas.TotalPrice} * 100 / {!Recorrer_Lineas.Quantity}) / 100</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>NMD Pedido desde Oportunidad {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NMD Pedido desde Oportunidad</label>
