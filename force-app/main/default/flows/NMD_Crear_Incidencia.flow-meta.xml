    <decisions>
        <name>Contacto_Encontrado</name>
        <label>¿Contacto encontrado?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Verificado_Contacto</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No encontrado</defaultConnectorLabel>
        <rules>
            <name>Encontrado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contacto</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
