            </connector>
            <label>Sí</label>
        </rules>
    </decisions>
    <decisions>
        <name>Validar_Entradas</name>
        <label>¿Entradas válidas?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Asignar_Datos_No_Validos</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No válidas</defaultConnectorLabel>
        <rules>
            <name>Entradas_Validas</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4 OR 5) AND 6</conditionLogic>
            <conditions>
                <leftValueReference>tipo</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Producto defectuoso</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>tipo</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Queja</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>gravedad</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Baja</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>gravedad</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Media</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>gravedad</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Alta</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>email</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contacto</targetReference>
            </connector>
            <label>Válidas</label>
        </rules>
    </decisions>
    <description>Acción del Agente Zen. Crea un caso de tipo Producto defectuoso o Queja para el contacto del email. Si se indica un pedido, debe pertenecer a ese contacto. Una Queja de gravedad Alta se crea con prioridad High; el resto, Medium. El caso se asigna a la cola Agentes NMD.</description>
    <environments>Default</environments>
    <formulas>
        <name>fAsunto</name>
        <dataType>String</dataType>
        <expression>{!tipo} &amp; &apos; (gravedad &apos; &amp; {!gravedad} &amp; &apos;)&apos; &amp; IF(ISBLANK({!numeroPedido}), &apos;&apos;, &apos; - pedido &apos; &amp; {!numeroPedido})</expression>
    </formulas>
    <formulas>
        <name>fDescripcion</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!descripcion}), &apos;Sin descripción.&apos;, {!descripcion})</expression>
    </formulas>
    <formulas>
        <name>fMensajeOk</name>
        <dataType>String</dataType>
        <expression>&apos;Hemos registrado tu incidencia con el caso &apos; &amp; {!Get_Caso.CaseNumber} &amp; &apos;.&apos; &amp; IF({!fPrioridad} = &apos;High&apos;, &apos; La hemos marcado como prioridad alta y el equipo la revisará cuanto antes.&apos;, &apos; El equipo de NMD la revisará en breve.&apos;)</expression>
    </formulas>
    <formulas>
        <name>fPrioridad</name>
        <dataType>String</dataType>
        <expression>IF(AND({!tipo} = &apos;Queja&apos;, {!gravedad} = &apos;Alta&apos;), &apos;High&apos;, &apos;Medium&apos;)</expression>
    </formulas>
