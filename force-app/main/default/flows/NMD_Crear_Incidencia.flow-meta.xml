                </rightValue>
            </conditions>
            <connector>
                <targetReference>Hay_Pedido</targetReference>
            </connector>
            <label>Encontrado</label>
        </rules>
    </decisions>
    <decisions>
        <name>Hay_Pedido</name>
        <label>¿Se indicó pedido?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Cola</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sin pedido</defaultConnectorLabel>
        <rules>
            <name>Con_Pedido</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numeroPedido</leftValueReference>
