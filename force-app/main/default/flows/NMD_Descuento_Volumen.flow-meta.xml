<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>NMD Distribución. Cuando se crea una línea de presupuesto o cambian sus cajas o su descuento adicional, recalcula el descuento por volumen de todo el presupuesto (subflow NMD_Recalcular_Presupuesto).</description>
    <environments>Default</environments>
    <interviewLabel>NMD Descuento Volumen {!$Flow.CurrentDateTime}</interviewLabel>
    <label>NMD Descuento Volumen</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Recalcular</targetReference>
        </connector>
        <filterFormula>OR(ISNEW(), ISCHANGED({!$Record.Quantity}), ISCHANGED({!$Record.Descuento_adicional__c}))</filterFormula>
        <object>QuoteLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Recalcular</name>
        <label>Recalcular presupuesto</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>NMD_Recalcular_Presupuesto</flowName>
        <inputAssignments>
            <name>quoteId</name>
            <value>
                <elementReference>$Record.QuoteId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
